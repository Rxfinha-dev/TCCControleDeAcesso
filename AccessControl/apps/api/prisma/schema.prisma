// Schema do banco de dados do HelpUs (PostgreSQL / Supabase).
// Equivalente moderno das tabelas legadas: escolas, cursos, alunos e entradas.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: use a URL do pooler (porta 6543, ?pgbouncer=true) em runtime...
  url       = env("DATABASE_URL")
  // ...e a conexão direta/session pooler (porta 5432) para migrations.
  directUrl = env("DIRECT_URL")
}

enum SchoolYear {
  FIRST
  SECOND
  THIRD
}

enum AccessMethod {
  FINGERPRINT
  MANUAL
}

/// Perfil de acesso. STUDENT, EMPLOYEE e TEACHER ainda não têm acesso ao painel.
enum UserRole {
  SUPER_ADMIN
  SCHOOL
  STUDENT
  EMPLOYEE
  TEACHER
}

/// Turno da turma.
enum Shift {
  MORNING
  AFTERNOON
  EVENING
  FULL_TIME
}

/// Tipo de bloco da grade: aula (conta presença) ou intervalo (só exibição).
enum TimetableSlotKind {
  LESSON
  BREAK
}

/// Usuário do sistema, ligado ao Supabase Auth. O perfil vive só aqui (nunca em user_metadata).
model User {
  id         Int      @id @default(autoincrement())
  /// ID do usuário no Supabase Auth (auth.users.id).
  authUserId String   @unique @map("auth_user_id") @db.Uuid
  email      String   @unique @db.VarChar(120)
  name       String   @db.VarChar(100)
  role       UserRole @default(SCHOOL)
  /// Escola do usuário. Para SCHOOL é obrigatória; para SUPER_ADMIN é a "escola padrão" (opcional).
  /// No máximo um SCHOOL por escola (índice único parcial users_school_role_key, criado na migration).
  schoolId   Int?     @map("school_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@map("users")
}

/// Instituição (antiga tabela "escolas"). O login é de um User (perfil SCHOOL) ligado a ela.
model School {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  /// Contato da escola e chave para vincular o primeiro login (provisionamento).
  email     String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       User[]
  courses     Course[]
  students    Student[]
  accessLogs  AccessLog[]
  teachers    Teacher[]
  subjects    Subject[]
  classGroups ClassGroup[]

  @@map("schools")
}

model Course {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(60)
  schoolId  Int      @map("school_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    Student[]
  classGroups ClassGroup[]

  @@unique([schoolId, name])
  @@map("courses")
}

model Student {
  id                    Int        @id @default(autoincrement())
  name                  String     @db.VarChar(100)
  rm                    String     @db.VarChar(8)
  age                   Int
  year                  SchoolYear
  courseId              Int        @map("course_id")
  schoolId              Int        @map("school_id")
  /// Caminho da foto no storage (Supabase Storage ou tabela student_photos).
  photoKey              String?    @map("photo_key") @db.VarChar(255)
  /// Posição da digital no sensor biométrico do Arduino (1..127).
  fingerprintId         Int?       @map("fingerprint_id")
  /// Preenchido quando o Arduino confirma o cadastro da digital ("!enrolled<id>#").
  fingerprintEnrolledAt DateTime?  @map("fingerprint_enrolled_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  photo       StudentPhoto?
  accessLogs  AccessLog[]
  enrollments Enrollment[]

  @@unique([schoolId, rm])
  @@unique([schoolId, fingerprintId])
  @@index([schoolId, name])
  @@map("students")
}

/// Armazenamento das fotos no próprio banco (driver STORAGE_DRIVER=database).
model StudentPhoto {
  studentId Int      @id @map("student_id")
  mimeType  String   @map("mime_type") @db.VarChar(50)
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_photos")
}

/// Registro de entradas (antiga tabela "entradas").
model AccessLog {
  id          Int          @id @default(autoincrement())
  schoolId    Int          @map("school_id")
  studentId   Int?         @map("student_id")
  /// Nome guardado no momento da entrada, para manter o histórico mesmo se o aluno for excluído.
  studentName String       @map("student_name") @db.VarChar(100)
  method      AccessMethod @default(FINGERPRINT)
  createdAt   DateTime     @default(now()) @map("created_at")

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("access_logs")
}

/// Professor da escola. Nesta etapa é só cadastro (o login vem depois).
model Teacher {
  id           Int      @id @default(autoincrement())
  schoolId     Int      @map("school_id")
  name         String   @db.VarChar(100)
  contactEmail String?  @map("contact_email") @db.VarChar(120)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]

  @@index([schoolId, name])
  @@map("teachers")
}

/// Disciplina da escola, usada nas turmas e na grade.
model Subject {
  id           Int      @id @default(autoincrement())
  schoolId     Int      @map("school_id")
  name         String   @db.VarChar(60)
  /// Sigla curta exibida na grade (ex.: "Mat.").
  abbreviation String   @db.VarChar(8)
  /// Cor no formato #RRGGBB.
  color        String   @db.VarChar(7)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  slots       TimetableSlot[]

  @@unique([schoolId, name])
  @@map("subjects")
}

/// Turma de um ano letivo. O curso é opcional (escolas de ensino regular não têm).
model ClassGroup {
  id         Int      @id @default(autoincrement())
  schoolId   Int      @map("school_id")
  name       String   @db.VarChar(40)
  schoolYear Int      @map("school_year")
  shift      Shift
  courseId   Int?     @map("course_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course            Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]
  assignments       TeachingAssignment[]
  timetableVersions TimetableVersion[]

  @@unique([schoolId, schoolYear, name])
  @@map("class_groups")
}

/// Matrícula do aluno numa turma, no intervalo [startDate, endDate).
/// No máximo uma matrícula aberta por aluno e ano (índice parcial enrollments_open_key, criado na migration).
model Enrollment {
  id           Int       @id @default(autoincrement())
  classGroupId Int       @map("class_group_id")
  studentId    Int       @map("student_id")
  schoolYear   Int       @map("school_year")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, schoolYear])
  @@index([classGroupId])
  @@map("enrollments")
}

/// Quem leciona cada disciplina em cada turma.
model TeachingAssignment {
  id           Int      @id @default(autoincrement())
  classGroupId Int      @map("class_group_id")
  subjectId    Int      @map("subject_id")
  teacherId    Int      @map("teacher_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: NoAction)
  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: NoAction)

  @@unique([classGroupId, subjectId])
  @@index([teacherId])
  @@map("teaching_assignments")
}

/// Versão da grade de uma turma. Vale a partir de validFrom até a próxima versão.
model TimetableVersion {
  id           Int      @id @default(autoincrement())
  classGroupId Int      @map("class_group_id")
  validFrom    DateTime @map("valid_from") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  classGroup ClassGroup      @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  slots      TimetableSlot[]

  @@unique([classGroupId, validFrom])
  @@map("timetable_versions")
}

/// Bloco da grade: dia da semana (1 = segunda ... 6 = sábado) e minutos desde 00:00.
model TimetableSlot {
  id          Int               @id @default(autoincrement())
  versionId   Int               @map("version_id")
  kind        TimetableSlotKind
  subjectId   Int?              @map("subject_id")
  weekday     Int
  startMinute Int               @map("start_minute")
  endMinute   Int               @map("end_minute")

  version TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  subject Subject?         @relation(fields: [subjectId], references: [id], onDelete: NoAction)

  @@index([versionId])
  @@index([subjectId])
  @@map("timetable_slots")
}
