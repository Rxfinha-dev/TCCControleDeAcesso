// Schema do banco de dados do HelpUs (PostgreSQL / Supabase).
// Equivalente moderno das tabelas legadas: escolas, cursos, alunos e entradas.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: use a URL do pooler (porta 6543, ?pgbouncer=true) em runtime...
  url       = env("DATABASE_URL")
  // ...e a conexão direta/session pooler (porta 5432) para migrations.
  directUrl = env("DIRECT_URL")
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SchoolYear {
  FIRST
  SECOND
  THIRD
}

enum AccessMethod {
  FINGERPRINT
  MANUAL
}

/// Instituição (antiga tabela "escolas"). É a conta que faz login no sistema.
model School {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(120)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Incrementado ao trocar a senha: invalida todos os tokens JWT emitidos antes.
  sessionVersion  Int       @default(0) @map("session_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  courses           Course[]
  students          Student[]
  accessLogs        AccessLog[]
  verificationCodes VerificationCode[]

  @@map("schools")
}

/// Códigos de 6 dígitos enviados por e-mail (ativação de conta e recuperação de senha).
model VerificationCode {
  id         Int         @id @default(autoincrement())
  schoolId   Int         @map("school_id")
  purpose    CodePurpose
  codeHash   String      @map("code_hash") @db.VarChar(255)
  attempts   Int         @default(0)
  expiresAt  DateTime    @map("expires_at")
  consumedAt DateTime?   @map("consumed_at")
  createdAt  DateTime    @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, purpose])
  @@map("verification_codes")
}

model Course {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(60)
  schoolId  Int      @map("school_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([schoolId, name])
  @@map("courses")
}

model Student {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  rm            String     @db.VarChar(8)
  age           Int
  year          SchoolYear
  courseId      Int        @map("course_id")
  schoolId      Int        @map("school_id")
  /// Caminho da foto no storage (Supabase Storage ou tabela student_photos).
  photoKey      String?    @map("photo_key") @db.VarChar(255)
  /// Posição da digital no sensor biométrico do Arduino (1..127).
  fingerprintId Int?       @map("fingerprint_id")
  /// Preenchido quando o Arduino confirma o cadastro da digital ("!enrolled<id>#").
  fingerprintEnrolledAt DateTime? @map("fingerprint_enrolled_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course     Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  photo      StudentPhoto?
  accessLogs AccessLog[]

  @@unique([schoolId, rm])
  @@unique([schoolId, fingerprintId])
  @@index([schoolId, name])
  @@map("students")
}

/// Armazenamento das fotos no próprio banco (driver STORAGE_DRIVER=database).
model StudentPhoto {
  studentId Int      @id @map("student_id")
  mimeType  String   @map("mime_type") @db.VarChar(50)
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_photos")
}

/// Registro de entradas (antiga tabela "entradas").
model AccessLog {
  id          Int          @id @default(autoincrement())
  schoolId    Int          @map("school_id")
  studentId   Int?         @map("student_id")
  /// Nome guardado no momento da entrada, para manter o histórico mesmo se o aluno for excluído.
  studentName String       @map("student_name") @db.VarChar(100)
  method      AccessMethod @default(FINGERPRINT)
  createdAt   DateTime     @default(now()) @map("created_at")

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("access_logs")
}
