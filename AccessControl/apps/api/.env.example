# ---------------------------------------------------------------
# HelpUs API - variáveis de ambiente
# Copie para .env e ajuste os valores.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# URL(s) do frontend liberadas no CORS (separe várias por vírgula)
CORS_ORIGIN=http://localhost:5173

# --- Banco de dados ---------------------------------------------
# Local (docker compose):
DATABASE_URL=postgresql://helpus:helpus@localhost:5432/helpus?schema=public
DIRECT_URL=postgresql://helpus:helpus@localhost:5432/helpus?schema=public
# Supabase (Project Settings > Database > Connection string):
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# --- Autenticação (Supabase Auth) -------------------------------
# Project Settings > API Keys. O login, a ativação por código e a recuperação de
# senha acontecem no Supabase; a API só valida os tokens emitidos por ele.
SUPABASE_URL=https://<ref>.supabase.co
# Chave publicável (sb_publishable_...) ou a "anon" legada. Nunca a secret/service_role.
SUPABASE_PUBLISHABLE_KEY=

# --- Fotos dos alunos -------------------------------------------
# database = salva no Postgres | supabase = Supabase Storage
STORAGE_DRIVER=database
# Secret key (sb_secret_...) ou service_role. Exigida com STORAGE_DRIVER=supabase;
# também permite que o seed crie o usuário de demonstração no Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-photos
