# URL pública da API (com /api no final).
# Em desenvolvimento deixe vazio: o Vite encaminha /api para http://localhost:3333.
VITE_API_URL=

# Supabase Auth (Project Settings > API Keys). A chave publicável pode ficar no navegador.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
